# Required
BOT_TOKEN=123456:ABC-your-botfather-token

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=

# --- limits (defaults shown) ---
# MAX_FILE_MB=1900        hard abort for downloads
# SEND_MB=49              Telegram bot upload cap
# PLAYLIST_MAX=20
# MULTI_URL_MAX=5
# MAX_CONCURRENT=2
# RATE_LIMIT_SECONDS=3
# DOWNLOAD_TIMEOUT=1800

# --- optional integrations ---
# PROXY_URL=http://user:pass@host:port   routes yt-dlp traffic (e.g. residential proxy for YouTube)
# YT_COOKIES=/data/cookies.txt           YouTube cookies export, enables YouTube from datacenter IPs
# REDIS_URL=redis://...                  reserved; in-process queue is the default
# SENTRY_DSN=https://...                 error tracking

# --- storage ---
# DATA_DIR=/data
# DB_PATH=/data/udv3.db
# TMP_DIR=/data/tmp

# --- runtime ---
# HEALTH_PORT=8080
# LOG_LEVEL=INFO
